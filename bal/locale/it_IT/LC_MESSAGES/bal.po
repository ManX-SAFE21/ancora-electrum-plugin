#: bal/core/messages.py:57
#, python-brace-format
msgid "Miner fee rate changed (the will was built with {} sat/byte, now it is {}): a new will must be prepared."
msgstr "La commissione dei miner è cambiata (il testamento è stato creato con {} sat/byte, ora è {}): bisogna preparare un nuovo testamento."

#: bal/core/messages.py:61
msgid "The miner fee rate changed: a new will must be prepared."
msgstr "La commissione dei miner è cambiata: bisogna preparare un nuovo testamento."

#: bal/core/messages.py:64
#, python-brace-format
msgid "Will-executor \"{}\" is not covered by the current will: a new will must be prepared."
msgstr "Il Will-Executor \"{}\" non è compreso nel testamento attuale: bisogna preparare un nuovo testamento."

#: bal/core/messages.py:69
msgid "Backup mode is enabled but the will has no backup transaction: a new will must be prepared."
msgstr "La transazione senza Will-Executor (tx di backup) è attiva ma il testamento non ha la transazione scritta: bisogna preparare un nuovo testamento."

#: bal/core/messages.py:78
#, python-brace-format
msgid "Heir \"{}\" was removed: preparing a new will."
msgstr "L'erede \"{}\" è stato tolto: preparo un nuovo testamento."

#: bal/core/messages.py:80
#, python-brace-format
msgid "Heir \"{}\" was added: preparing a new will."
msgstr "L'erede \"{}\" è stato aggiunto: preparo un nuovo testamento."

#: bal/core/messages.py:83
#, python-brace-format
msgid "The delivery date of heir \"{}\" changed: preparing a new will."
msgstr "La data dell'erede \"{}\" è cambiata: preparo un nuovo testamento."

#: bal/core/messages.py:87
#, python-brace-format
msgid "The amount of heir \"{}\" changed: preparing a new will."
msgstr "L'importo dell'erede \"{}\" è cambiato: preparo un nuovo testamento."

#: bal/core/messages.py:91
#, python-brace-format
msgid "The address of heir \"{}\" changed: preparing a new will."
msgstr "L'indirizzo dell'erede \"{}\" è cambiato: preparo un nuovo testamento."

#: bal/core/messages.py:94
#, python-brace-format
msgid "Heir \"{}\" is not covered by the current will (it was added or removed, or its delivery date changed): a new will must be prepared."
msgstr "L'erede \"{}\" non è compreso nel testamento attuale (è stato aggiunto o rimosso, o la sua data di consegna è cambiata): bisogna preparare un nuovo testamento."

#: bal/core/messages.py:102
msgid "The heirs changed: a new will must be prepared."
msgstr "Gli eredi sono cambiati: bisogna preparare un nuovo testamento."

#: bal/core/messages.py:104
msgid "A will-executor changed: a new will must be prepared."
msgstr "Un Will-Executor è cambiato: bisogna preparare un nuovo testamento."

#: bal/core/messages.py:111
msgid "The wallet contains funds that the current will does not cover yet: a new will must be prepared."
msgstr "Il portafogli contiene fondi che il testamento attuale non comprende ancora: bisogna preparare un nuovo testamento."

#: bal/core/messages.py:115
msgid "The will contains no valid transaction: a new will must be prepared."
msgstr "Il testamento non contiene transazioni valide: bisogna preparare un nuovo testamento."

#: bal/core/messages.py:121
msgid "The will is no longer coherent and must be rebuilt; the exact reason could not be determined."
msgstr "Il testamento non è più coerente e va ricreato; non è stato possibile determinare il motivo esatto."

