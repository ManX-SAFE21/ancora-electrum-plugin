"  $wallet_name: name of wallet\n"
"  $heirs_complete: list of heirs name,address,amount\n"
"Only used in ADVANCED mode."
msgstr ""
"Messaggio predefinito per il titolo dell'evento\n"
"Variabili:\n"
"  $wallet_name: nome del portafogli\n"
"  $heirs_complete: elenco degli eredi con nome, indirizzo, importo\n"
"Usato solo in modalità AVANZATA."

#: bal/gui/qt/plugin.py:854
msgid "Event description"
msgstr "Descrizione dell'evento"

