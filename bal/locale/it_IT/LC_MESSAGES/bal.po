msgstr "Controlla di averlo copiato tutto, senza caratteri in più o in meno."

#: bal/core/messages.py:610
msgid "The OP_RETURN message is not valid: it must be written in hexadecimal."
msgstr "Il messaggio OP_RETURN non è valido: deve essere scritto in esadecimale."

#: bal/core/messages.py:614
#, python-brace-format
msgid "The OP_RETURN message is too long: {} bytes, at most 80."
msgstr "Il messaggio OP_RETURN è troppo lungo: {} byte, al massimo 80."

#: bal/core/messages.py:617
msgid "The date of this heir is already past."
msgstr "La data di questo erede è già passata."

