#: bal/gui/qt/report_pages.py:507
msgid "As long as you renew the will before the delivery date (moving it later), your bitcoin stays yours. If you stop, from the delivery date the will-executors broadcast the transaction already signed and the heirs receive the amounts shown above."
msgstr "Finché rinnovi il testamento prima della data di consegna (spostandola più avanti), i bitcoin restano tuoi. Se smetti, dalla data di consegna i will-executor trasmettono la transazione già firmata e gli eredi ricevono gli importi indicati sopra."

#: bal/gui/qt/report_pages.py:570
#, python-brace-format
msgid "Each delivery spends the change of the one before at every will-executor, so the transactions multiply: {}. Only one transaction per delivery can ever be confirmed."
msgstr "Ogni consegna spende il resto di quella precedente presso ogni will-executor, quindi le transazioni si moltiplicano: {}. Per ogni consegna potrà essere confermata una sola transazione."

#: bal/gui/qt/report_pages.py:608 bal/gui/qt/report_pages.py:609
#: bal/gui/qt/report_pages.py:683
msgid "TECHNICAL DETAILS"
msgstr "DETTAGLI TECNICI"

#: bal/gui/qt/report_pages.py:636
msgid "Only the transactions of delivery 1 are listed here. The full list is in the will file (Tools → Export)."
msgstr "Qui sono elencate solo le transazioni della consegna 1. L'elenco completo è nel file del testamento (Tools → Esporta)."

#: bal/gui/qt/report_pages.py:640
msgid "Wills sent before and still held by the will-executors"
msgstr "Testamenti inviati prima e ancora custoditi dai will-executor"

#: bal/gui/qt/report_pages.py:644
msgid "None: the will-executors hold no other will that can still be executed."
msgstr "Nessuno: i will-executor non custodiscono altri testamenti ancora eseguibili."

