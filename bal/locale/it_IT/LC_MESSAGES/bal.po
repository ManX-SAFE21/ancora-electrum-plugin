msgstr "Non è un indirizzo valido per questa rete: {}"

#: bal/core/messages.py:514
msgid "Check that you copied all of it, with no extra or missing characters."
msgstr "Controlla di averlo copiato tutto, senza caratteri in più o in meno."

#: bal/core/messages.py:517
msgid "The OP_RETURN message is not valid: it must be written in hexadecimal."
msgstr "Il messaggio OP_RETURN non è valido: deve essere scritto in esadecimale."

#: bal/core/messages.py:521
#, python-brace-format
msgid "The OP_RETURN message is too long: {} bytes, at most 80."
msgstr "Il messaggio OP_RETURN è troppo lungo: {} byte, al massimo 80."

#: bal/core/messages.py:524
msgid "The date of this heir is already past."
msgstr "La data di questo erede è già passata."

#: bal/core/messages.py:526
msgid "The date of this heir is not valid."
msgstr "La data di questo erede non è valida."

#: bal/core/messages.py:528
msgid "The amount is not valid: write a number, or a percentage such as 25%."
msgstr "L'importo non è valido: scrivi un numero, oppure una percentuale come 25%."

