#: bal/gui/qt/dialogs.py:2382
#, python-brace-format
msgid "The fixed amounts ({fixed} sat) exceed the balance available for the heirs ({balance} sat). Reduce the fixed amounts."
msgstr "Gli importi fissi ({fixed} sat) superano il saldo disponibile per gli eredi ({balance} sat). Riduci gli importi fissi."

#: bal/gui/qt/dialogs.py:2390
#, python-brace-format
msgid "The heirs' percentages add up to {total}%: the will always empties the whole wallet, so the shares of what remains after the fixed amounts are recalculated in proportion ({shares})."
msgstr "Le percentuali degli eredi sommano al {total}%: il testamento svuota sempre tutto il portafogli, quindi le quote di ciò che resta dopo gli importi fissi vengono ricalcolate in proporzione ({shares})."

#: bal/gui/qt/dialogs.py:2395
#, python-brace-format
msgid "The heirs' percentages add up to {total}%: the will always empties the whole wallet, so the shares are recalculated in proportion ({shares})."
msgstr "Le percentuali degli eredi sommano al {total}%: il testamento svuota sempre tutto il portafogli, quindi le quote vengono ricalcolate in proporzione ({shares})."

#: bal/gui/qt/dialogs.py:2442
#, python-brace-format
msgid "The delivery date ({}) has already passed. Choose a future date, then press Check again."
msgstr "La data di consegna ({}) è già passata. Scegli una data futura, poi premi di nuovo Controlla."

#: bal/gui/qt/dialogs.py:2477
msgid "No heirs: add at least one heir before building the will."
msgstr "Nessun erede: aggiungi almeno un erede prima di preparare il testamento."

#: bal/gui/qt/dialogs.py:2480
