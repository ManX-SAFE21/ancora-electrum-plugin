#: bal/gui/qt/window.py:1114
msgid ""
"Your inheritance has been rebuilt and now needs to be signed again.\n"
"\n"
"Next step (manual):\n"
"  1. Press 'Sign' to sign the new transaction."
msgstr ""
"Tu herencia se ha recreado y ahora hay que volver a firmarla.\n"
"\n"
"Siguiente paso (manual):\n"
"  1. Pulsa 'Firmar' para firmar la nueva transacción."

#: bal/gui/qt/window.py:1121
msgid ""
"Your inheritance has been rebuilt and now needs to be signed and re-sent to the will-executors.\n"
"\n"
"Next steps (manual):\n"
"  1. Press 'Sign' to sign the new transaction.\n"
"  2. Press 'Broadcast' to send it to the will-executors."
msgstr ""
"Tu herencia se ha recreado y ahora hay que firmarla y volver a enviarla a los Will-Executor.\n"
"\n"
"Siguientes pasos (manual):\n"
"  1. Pulsa 'Firmar' para firmar la nueva transacción.\n"
"  2. Pulsa 'Transmitir' para enviarla a los Will-Executor."

