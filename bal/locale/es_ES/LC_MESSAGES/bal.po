"Variables:\n"
"  $wallet_name: nombre de la cartera\n"
"  $heirs_complete: lista de herederos nombre,dirección,importe\n"
"Solo se usa en modo AVANZADO."

#: bal/gui/qt/plugin.py:854
msgid "Event description"
msgstr "Descripción del evento"

#: bal/gui/qt/plugin.py:856
