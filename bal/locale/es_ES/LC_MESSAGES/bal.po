#: bal/core/messages.py:57
#, python-brace-format
msgid "Miner fee rate changed (the will was built with {} sat/byte, now it is {}): a new will must be prepared."
msgstr "La tasa de comisión de minería ha cambiado (el testamento se creó con {} sat/byte, ahora es {}): hay que preparar un nuevo testamento."

#: bal/core/messages.py:61
msgid "The miner fee rate changed: a new will must be prepared."
msgstr "La tasa de comisión de minería ha cambiado: hay que preparar un nuevo testamento."

#: bal/core/messages.py:64
#, python-brace-format
msgid "Will-executor \"{}\" is not covered by the current will: a new will must be prepared."
msgstr "El Will-Executor \"{}\" no está cubierto por el testamento actual: hay que preparar un nuevo testamento."

#: bal/core/messages.py:69
msgid "Backup mode is enabled but the will has no backup transaction: a new will must be prepared."
msgstr "El modo de copia de seguridad está activado pero el testamento no tiene transacción de copia de seguridad: hay que preparar un nuevo testamento."

#: bal/core/messages.py:78
#, python-brace-format
msgid "Heir \"{}\" was removed: preparing a new will."
msgstr "El heredero \"{}\" ha sido eliminado: preparo un nuevo testamento."

#: bal/core/messages.py:80
#, python-brace-format
msgid "Heir \"{}\" was added: preparing a new will."
msgstr "El heredero \"{}\" ha sido añadido: preparo un nuevo testamento."

#: bal/core/messages.py:83
#, python-brace-format
msgid "The delivery date of heir \"{}\" changed: preparing a new will."
msgstr "La fecha del heredero \"{}\" ha cambiado: preparo un nuevo testamento."

#: bal/core/messages.py:87
#, python-brace-format
msgid "The amount of heir \"{}\" changed: preparing a new will."
msgstr "El importe del heredero \"{}\" ha cambiado: preparo un nuevo testamento."

#: bal/core/messages.py:91
#, python-brace-format
msgid "The address of heir \"{}\" changed: preparing a new will."
msgstr "La dirección del heredero \"{}\" ha cambiado: preparo un nuevo testamento."

#: bal/core/messages.py:94
#, python-brace-format
msgid "Heir \"{}\" is not covered by the current will (it was added or removed, or its delivery date changed): a new will must be prepared."
msgstr "El heredero \"{}\" no está cubierto por el testamento actual (se añadió o se eliminó, o cambió su fecha de entrega): hay que preparar un nuevo testamento."

#: bal/core/messages.py:102
msgid "The heirs changed: a new will must be prepared."
msgstr "Los herederos han cambiado: hay que preparar un nuevo testamento."

#: bal/core/messages.py:104
msgid "A will-executor changed: a new will must be prepared."
msgstr "Un Will-Executor ha cambiado: hay que preparar un nuevo testamento."

#: bal/core/messages.py:111
msgid "The wallet contains funds that the current will does not cover yet: a new will must be prepared."
msgstr "La cartera contiene fondos que el testamento actual aún no cubre: hay que preparar un nuevo testamento."

#: bal/core/messages.py:115
msgid "The will contains no valid transaction: a new will must be prepared."
msgstr "El testamento no contiene ninguna transacción válida: hay que preparar un nuevo testamento."

#: bal/core/messages.py:121
msgid "The will is no longer coherent and must be rebuilt; the exact reason could not be determined."
msgstr "El testamento ya no es coherente y debe recrearse; no se pudo determinar el motivo exacto."

